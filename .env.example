# Local engineering skeleton only. No real credentials are required.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3002
# For a phone, set a reachable LAN/HTTPS origin, not localhost.
# Binding API_HOST=0.0.0.0 is an explicit development-only LAN opt-in.
EXPO_PUBLIC_API_URL=
AUTH_DEV_MODE=false
# Database, queues, authentication and AI providers are not initialized yet.
