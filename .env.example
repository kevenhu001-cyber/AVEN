# Local engineering skeleton only. No real credentials are required.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3002
# For a phone, set a reachable LAN/HTTPS origin, not localhost.
# Binding API_HOST=0.0.0.0 is an explicit development-only LAN opt-in.
EXPO_PUBLIC_API_URL=
AUTH_DEV_MODE=true
AUTH_SESSION_TTL_DAYS=30
AUTH_IP_SALT=aven_dev_ip_salt_change_me
AUTH_MAIL_DIR=.data/mail
# Explicit transactional mail mode: file (development), smtp, or disabled.
AUTH_MAIL_TRANSPORT=file
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Memory lifecycle maintenance (run: corepack pnpm memory:maintain).
MEMORY_DELETION_RETENTION_DAYS=30
MEMORY_EVENT_RETENTION_DAYS=365
AGENT_EVENT_RETENTION_HOURS=24

# AI provider. Mock is the default and needs no key. Real provider keys are
# never committed; the OpenAI-compatible adapter is not verified live yet.
# 开发默认 Mock。真实个人聊天需显式授权；组织/旧 Mock run 不升级外发。
# 部署凭据仅放受限服务环境，模式由 GET /api/v1/agent/runtime 提供。
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=15000
# Server-managed encryption key and explicit allowed HTTPS provider URLs for user settings.
# Generate a unique 32-byte base64 key via your secret manager; do not commit it.
AI_USER_CONFIG_KEY=
AI_USER_ALLOWED_BASE_URLS=

# Local Compose infrastructure. These are development-only placeholders.
# Copy this file to .env and replace every password before using a shared machine.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=aven
POSTGRES_TEST_DB=aven_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=aven_dev_superuser_change_me
AVEN_MIGRATOR_PASSWORD=aven_dev_migrator_change_me
AVEN_APP_PASSWORD=aven_dev_app_change_me
AVEN_WORKER_PASSWORD=aven_dev_worker_change_me
AVEN_AUTH_PASSWORD=aven_dev_auth_change_me
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=aven_dev_redis_change_me

# Optional explicit connection strings. Defaults derive from the fields above.
# DATABASE_URL=postgres://aven_app:...@127.0.0.1:55432/aven
# MIGRATION_DATABASE_URL=postgres://aven_migrator:...@127.0.0.1:55432/aven

# Authentication is initialized for local development; production email and AI
# providers are not configured. Never use aven_migrator for request handling.

# Explicit personal connection maintenance batch (1-1000); retention windows are fixed.
CONNECTION_MAINTENANCE_BATCH_SIZE=100

# Explicit in-app notification retention batch; inbox retention is fixed at 90 days.
NOTIFICATION_MAINTENANCE_BATCH_SIZE=100
