{
  "name": "aven",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "dev:web": "pnpm build:packages && node scripts/dev.mjs web",
    "dev:api": "pnpm build:packages && node scripts/dev.mjs api",
    "dev:worker": "pnpm build:packages && node scripts/dev.mjs worker",
    "dev:mobile": "pnpm build:packages && node scripts/dev.mjs mobile",
    "build": "turbo run build --concurrency=1",
    "build:packages": "turbo run build --filter='./packages/*' --concurrency=1",
    "typecheck": "turbo run typecheck --concurrency=1",
    "lint": "eslint . --max-warnings=0 && pnpm check:boundaries",
    "check:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs --output-type err",
    "check:expo": "pnpm --filter @aven/mobile check:expo",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:status": "node scripts/infra.mjs status",
    "infra:logs": "node scripts/infra.mjs logs",
    "infra:reset": "node scripts/infra.mjs reset",
    "infra:verify": "node scripts/verify-infra.mjs",
    "db:migrate": "pnpm --filter @aven/database db:migrate",
    "db:status": "pnpm --filter @aven/database db:status",
    "db:seed": "pnpm --filter @aven/database db:seed",
    "db:verify": "node scripts/db-verify.mjs",
    "db:verify:current": "pnpm --filter @aven/database db:verify",
    "check:readiness": "node scripts/check-readiness.mjs",
    "async:verify": "tsx scripts/async-verify.ts",
    "auth:verify": "pnpm build && tsx scripts/auth-verify.ts",
    "profile:verify": "pnpm build && tsx scripts/profile-verify.ts",
    "organization:verify": "pnpm build && tsx scripts/organization-verify.ts",
    "isolation:verify": "pnpm build && tsx scripts/isolation-verify.ts",
    "memory:verify": "pnpm build && tsx scripts/memory-verify.ts",
    "memory:maintain": "pnpm build:packages && tsx scripts/memory-maintenance.ts",
    "ai:verify": "pnpm build:packages && tsx scripts/ai-verify.ts",
    "ai:eval": "pnpm build:packages && tsx scripts/ai-eval.ts",
    "agent:verify": "pnpm build && tsx scripts/agent-verify.ts",
    "agent:maintain": "pnpm build:packages && tsx scripts/agent-maintenance.ts",
    "action:verify": "pnpm build && tsx scripts/action-verify.ts",
    "opportunity:verify": "pnpm build && tsx scripts/opportunity-verify.ts",
    "opportunity:maintain": "pnpm build:packages && tsx scripts/opportunity-maintenance.ts",
    "m5:verify": "pnpm build && tsx scripts/m5-journey-verify.ts",
    "m6:verify": "pnpm build && tsx scripts/m6-journey-verify.ts",
    "org:verify": "pnpm build && tsx scripts/org-boundary-verify.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && vitest run",
    "test:e2e": "playwright test",
    "design:verify": "node scripts/design-prototype-verify.mjs",
    "design:verify:mascot": "node scripts/mascot-motion-verify.mjs",
    "connections:verify": "pnpm build && tsx scripts/connections-verify.ts",
    "connections:maintain": "pnpm build:packages && tsx scripts/connections-maintenance.ts",
    "connections:verify:retention": "pnpm build:packages && tsx scripts/connections-maintenance-verify.ts",
    "notifications:verify": "pnpm build && tsx scripts/notifications-verify.ts",
    "notifications:verify:events": "pnpm build && tsx scripts/event-notifications-verify.ts",
    "notifications:maintain": "pnpm build:packages && tsx scripts/notifications-maintenance.ts",
    "messages:verify": "pnpm build && tsx scripts/peer-messages-verify.ts",
    "moderation:verify": "pnpm build && tsx scripts/moderation-verify.ts",
    "supplements:verify": "pnpm build && tsx scripts/referral-supplements-verify.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
