{
  "name": "@aven/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --lan",
    "build": "expo export --platform android --output-dir dist --max-workers 1",
    "typecheck": "tsc --noEmit",
    "check:expo": "expo install --check",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "build:android": "expo run:android --variant release"
  },
  "dependencies": {
    "@aven/api-client": "workspace:*",
    "@aven/contracts": "workspace:*",
    "@aven/design-tokens": "workspace:*",
    "@expo/log-box": "58.0.15",
    "@expo/metro-runtime": "58.0.17",
    "@expo/ui": "58.0.28",
    "expo": "58.0.25",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.8",
    "expo-dev-client": "58.0.20",
    "expo-font": "58.0.12",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.31",
    "expo-secure-store": "58.0.3",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "expo-symbols": "58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@aven/config": "workspace:*",
    "@babel/core": "7.29.7",
    "@react-native/metro-config": "0.88.1",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.1.0",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3"
  }
