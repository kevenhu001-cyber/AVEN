{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["APP_ENV", "API_INTERNAL_URL", "EXPO_PUBLIC_API_URL", "CI"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] }
  }
}
